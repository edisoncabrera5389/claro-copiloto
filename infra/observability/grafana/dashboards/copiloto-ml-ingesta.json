 "description": "Drift de los modelos (PSI), cascada de intención, frescura de la base de conocimiento y flujos n8n.",
 "tags": [
  "claro-copiloto"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
