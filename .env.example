# Copiar a .env y completar. Nunca versionar .env.

# --- LLM ---
OPENAI_API_KEY=
# Los modelos por tier (economico, alto, embedding, local) se configuran en infra/litellm/config.yaml.
# Clave del gateway LiteLLM (la usan la API y la evaluación). Generar: py -3.13 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=sk-cambiar
# Modelo de embeddings de la ingesta (debe coincidir con el alias "embedding" de LiteLLM)
EMBEDDING_MODEL=text-embedding-3-small
# Opcional: segundo proveedor
GEMINI_API_KEY=

# --- Servicios simulados (CRM / Facturación / ERP) ---
# Mínimo 8 caracteres; sin ella los mocks no arrancan.
MOCKS_API_KEY=cambiar-por-una-clave-local
# Probabilidad de 503 simulado (0.02 = 2 %). En vivo: PUT /_admin/config
MOCKS_FAIL_RATE=0.02
MOCKS_RATE_LIMIT_PER_MIN=60
# "Hoy" del caso: ventanas de tickets, 12 meses de ofertas y fechas de lo creado
MOCKS_FECHA_REFERENCIA=2026-11-18

# --- Servidor MCP ---
# Firma HMAC de los tokens de confirmación de acciones con efecto (la API los emite, el MCP los verifica).
# Mínimo 32 caracteres. Generar: py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_CONFIRMACION_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
MCP_CONFIRMACION_TTL_S=300

# --- Ingesta (usa OPENAI_API_KEY y EMBEDDING_MODEL de arriba) ---
# Segundos entre escaneos de data/inbox y modelo de faster-whisper (tiny, base, small, medium)
INGESTA_POLL_S=3
INGESTA_WHISPER_MODELO=small

# --- API y agente ---
# Mínimo 32 caracteres. Generar: py -3.13 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_MIN=480
# Contraseña de los usuarios de demostración (A-001, A-002 asesores · SUP-001 supervisor · ADM-001 admin)
API_DEMO_PASSWORD=cambiar
# Reranker cross-encoder en CPU: desactivado (medido: +17 s de p95 sin mejorar el recall; ver eval/README.md)
API_RERANKER_ACTIVO=false
API_RATE_LIMIT_POR_MIN=30

# --- Datos ---
# Ruta local a los insumos de la prueba (solo para scripts/bootstrap_data.py)
INSUMOS_DIR=
