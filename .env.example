# Copiar a .env y completar. Nunca versionar .env.

# --- LLM ---
OPENAI_API_KEY=
# Modelos configurables por tier (ver infra/litellm)
LLM_MODEL_ECONOMICO=gpt-4.1-mini
LLM_MODEL_ALTO=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
# Opcional: segundo proveedor
GEMINI_API_KEY=

# --- Servicios simulados (CRM / Facturación / ERP) ---
MOCKS_API_KEY=cambiar-por-una-clave-local
MOCKS_FAIL_RATE=0.02
MOCKS_RATE_LIMIT_PER_MIN=60

# --- Autenticación de la API ---
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_MIN=480

# --- Datos ---
# Ruta local a los insumos de la prueba (solo para scripts/bootstrap_data.py)
INSUMOS_DIR=
